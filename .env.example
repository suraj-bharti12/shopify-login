# Copy this file to .env and fill it in. Store-specific settings (branding,
# domains, SMS text) are NOT here; they live in stores/<store>.json.

# ---------- Server ----------
# development while testing, production on the live server
NODE_ENV=development
PORT=3000
# Public HTTPS address of this server (your ngrok domain while testing,
# e.g. https://abc-def.ngrok-free.dev, later https://auth.yourbrand.com)
ISSUER=https://YOUR-NAME.ngrok-free.dev
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shopify_idp?retryWrites=true&w=majority

# Long random strings. Make each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_KEYS=change-me-1
OTP_SECRET=change-me-2

# true = /dev test page that acts like Shopify. false on the live server.
DEV_TEST_CLIENT=true

# ---------- OTP ----------
DEFAULT_COUNTRY_CODE=91
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---------- SMS: console | gupshup | msg91 | twilio ----------
# console = code is printed in the terminal (no SMS sent)
SMS_PROVIDER=gupshup
# Used when a store file has no "smsTemplate". {otp} is replaced with the code.
SMS_TEMPLATE="Your verification code is {otp}."
GUPSHUP_USERID=
GUPSHUP_PASSWORD=
GUPSHUP_MASK=
GUPSHUP_PRINCIPAL_ENTITY_ID=
GUPSHUP_DLT_TEMPLATE_ID=

# ---------- Email: console | smtp ----------
# console = code is printed in the terminal (no email sent)
MAIL_TRANSPORT=console
MAIL_FROM="My Brand <your.gmail@gmail.com>"
# Gmail: smtp.gmail.com, 465, true, your gmail, 16-letter App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---------- Google (console.cloud.google.com > APIs & Services > Credentials) ----------
# Authorized redirect URI to add there: ${ISSUER}/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Facebook (developers.facebook.com > your app > Facebook Login) ----------
# Valid OAuth Redirect URI: ${ISSUER}/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Apple (developer.apple.com) ----------
# Return URL: ${ISSUER}/social/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of AuthKey_XXXX.p8 on one line, with \n for new lines
APPLE_PRIVATE_KEY=
